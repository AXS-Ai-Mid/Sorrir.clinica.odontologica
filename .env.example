# ------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha os valores.
# O `.env` real NUNCA deve ser commitado no GitHub.
# ------------------------------------------------------------------

# Banco de dados PostgreSQL (obrigatório)
DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/app_db

# Senha do painel de leads em /admin (obrigatório em produção)
ADMIN_PASSWORD=troque-esta-senha

# URL canônica do site (usada em canonical, sitemap, JSON-LD e links absolutos)
NEXT_PUBLIC_SITE_URL=https://sorrirmaringa.com.br

# Aviso de novo lead por e-mail (opcional — integração Resend)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# LEAD_NOTIFICATION_EMAIL=atendimento@seudominio.com.br
# LEAD_NOTIFICATION_FROM=Site Sorrir <nao-responda@seudominio.com.br>

# Métricas (opcional — só carregam após consentimento de cookies)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=000000000000000
